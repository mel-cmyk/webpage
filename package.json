{
  "name": "melrolan-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node tests/check.mjs && node tests/texto.mjs",
    "test:browser": "node tests/comportamento.mjs",
    "verify": "node build.mjs && npm test && npm run test:browser && npm run test:acessibilidade && npm run test:orcamento",
    "referencia": "node tests/referencia.mjs salvar",
    "comparar": "node tests/referencia.mjs comparar",
    "visual:salvar": "node tests/visual.mjs salvar",
    "visual": "node tests/visual.mjs comparar",
    "estilos": "node tests/estilos.mjs",
    "texto": "node tests/texto.mjs",
    "test:acessibilidade": "node tests/acessibilidade.mjs",
    "test:orcamento": "node tests/orcamento.mjs",
    "lint": "eslint . && eslint --no-ignore dist/js/analytics.js",
    "formatar": "prettier --write .",
    "formatar:conferir": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
